generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoBolsa {
  activa
  cerrada
}

/// Cargo de un responsable dentro del comité de una bolsa (uno por cargo y bolsa).
enum CargoResponsable {
  tesorero
  presidente
  secretario
}

enum RolUsuario {
  superadmin
  admin
  usuario
}

enum EstadoFamilia {
  activa
  retirada
}

enum TipoPago {
  gasto
  devolucion
}

enum CanalRecordatorio {
  whatsapp
}

enum MedioAporte {
  yape
  plin
  tarjeta
  efectivo
}

enum EstadoAporte {
  confirmado
  por_confirmar
}

enum EstadoPago {
  pendiente
  pagado
  rechazado
  vencido
}

enum DecisionAprobacion {
  aprobo
  rechazo
}

enum TipoMovimiento {
  aporte
  pago_propuesto
  pago_aprobado
  pago_pagado
  pago_rechazado
  pago_vencido
}

enum FuenteRegistro {
  demostracion
  stellar
}

/// Identidad única de cada persona (una cuenta por DNI). El rol es global:
/// superadmin crea admins, admin crea bolsas, usuario participa en bolsas
/// a través de sus membresías (Familia, Responsable).
model Usuario {
  id                    String     @id @default(cuid())
  nombre                String
  apellidos             String
  dni                   String     @unique
  dniFotoUri            String?    @map("dni_foto_uri")
  celular               String
  rol                   RolUsuario
  contrasenaHash        String     @map("contrasena_hash")
  contrasenaSalt        String     @map("contrasena_salt")
  debeCambiarContrasena Boolean    @default(false) @map("debe_cambiar_contrasena")
  recuperacionHash      String?    @map("recuperacion_hash")
  recuperacionSalt      String?    @map("recuperacion_salt")

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  bolsasAdministradas Bolsa[]
  familias            Familia[]
  responsables        Responsable[]
  estudiantes         Estudiante[]

  @@map("usuarios")
}

model Bolsa {
  id                   String      @id @default(cuid())
  nombre               String
  colegio              String
  cuota                Decimal     @db.Decimal(10, 2)
  estudiantesEsperados Int?        @map("estudiantes_esperados")
  meta                 Decimal?    @db.Decimal(10, 2)
  actaUri              String?     @map("acta_uri")
  codigoPublico        String      @unique @map("codigo_publico")
  codigoInvitacion     String      @unique @map("codigo_invitacion")
  estado               EstadoBolsa @default(activa)
  adminId              String      @map("admin_id")
  admin                Usuario     @relation(fields: [adminId], references: [id], onDelete: NoAction)

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  responsables  Responsable[]
  familias      Familia[]
  inscripciones Inscripcion[]
  aportes       Aporte[]
  pagos         Pago[]
  registros     Registro[]
  recordatorios Recordatorio[]

  @@map("bolsas")
}

/// Membresía de un Usuario en el comité de una bolsa. Los datos personales viven en Usuario.
model Responsable {
  id        String           @id @default(cuid())
  bolsaId   String           @map("bolsa_id")
  bolsa     Bolsa            @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  usuarioId String           @map("usuario_id")
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: NoAction)
  cargo     CargoResponsable

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  aprobaciones          Aprobacion[]
  pagosPropuestos       Pago[]
  aportesRegistrados    Aporte[]       @relation("AporteRegistradoPor")
  aportesConfirmados    Aporte[]       @relation("AporteConfirmadoPor")
  recordatoriosEnviados Recordatorio[]

  @@unique([bolsaId, usuarioId])
  @@unique([bolsaId, cargo])
  @@map("responsables")
}

/// Membresía de un Usuario (padre o madre) en una bolsa. Los datos personales viven en Usuario.
model Familia {
  id         String        @id @default(cuid())
  bolsaId    String        @map("bolsa_id")
  bolsa      Bolsa         @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  usuarioId  String        @map("usuario_id")
  usuario    Usuario       @relation(fields: [usuarioId], references: [id], onDelete: NoAction)
  estado     EstadoFamilia @default(activa)
  retiradaEn DateTime?     @map("retirada_en")

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  inscripciones Inscripcion[]
  aportes       Aporte[]
  devoluciones  Pago[]
  recordatorios Recordatorio[]

  @@unique([bolsaId, usuarioId])
  @@map("familias")
}

/// Hijo o hija de un apoderado. Participa en una o varias bolsas a través de Inscripcion.
model Estudiante {
  id          String  @id @default(cuid())
  apoderadoId String  @map("apoderado_id")
  apoderado   Usuario @relation(fields: [apoderadoId], references: [id], onDelete: NoAction)
  nombre      String
  apellidos   String?

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  aportes       Aporte[]
  inscripciones Inscripcion[]

  @@map("estudiantes")
}

/// Participación de un estudiante en una bolsa, a través de la familia (membresía del padre).
model Inscripcion {
  id           String     @id @default(cuid())
  bolsaId      String     @map("bolsa_id")
  bolsa        Bolsa      @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  familiaId    String     @map("familia_id")
  familia      Familia    @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  estudianteId String     @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  @@unique([bolsaId, estudianteId])
  @@map("inscripciones")
}

model Aporte {
  id                  String       @id @default(cuid())
  bolsaId             String       @map("bolsa_id")
  bolsa               Bolsa        @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  familiaId           String       @map("familia_id")
  familia             Familia      @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  familiaNombre       String?      @map("familia_nombre")
  estudianteId        String?      @map("estudiante_id")
  estudiante          Estudiante?  @relation(fields: [estudianteId], references: [id])
  estudianteNombre    String?      @map("estudiante_nombre")
  monto               Decimal      @db.Decimal(10, 2)
  medio               MedioAporte
  estado              EstadoAporte @default(confirmado)
  /// Responsable del comité que registró el aporte en nombre del padre (null = lo registró el propio padre).
  registradoPorId     String?      @map("registrado_por_id")
  registradoPorResp   Responsable? @relation("AporteRegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction)
  registradoPorNombre String?      @map("registrado_por_nombre")
  confirmadoPorId     String?      @map("confirmado_por_id")
  confirmadoPorResp   Responsable? @relation("AporteConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: NoAction)
  fecha               DateTime     @default(now())
  codigoComprobante   String       @unique @map("codigo_comprobante")
  registroId          String?      @unique @map("registro_id")
  registro            Registro?    @relation(fields: [registroId], references: [id])

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  @@map("aportes")
}

model Pago {
  id               String      @id @default(cuid())
  bolsaId          String      @map("bolsa_id")
  bolsa            Bolsa       @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  proveedor        String
  cuentaProveedor  String?     @map("cuenta_proveedor")
  monto            Decimal     @db.Decimal(10, 2)
  motivo           String
  proponenteId     String      @map("proponente_id")
  proponente       Responsable @relation(fields: [proponenteId], references: [id])
  proponenteNombre String?     @map("proponente_nombre")
  estado           EstadoPago  @default(pendiente)
  venceEn          DateTime?   @map("vence_en")
  pagadoEn         DateTime?   @map("pagado_en")
  motivoRechazo    String?     @map("motivo_rechazo")
  comprobanteUri   String?     @map("comprobante_uri")
  registroId       String?     @unique @map("registro_id")
  registro         Registro?   @relation(fields: [registroId], references: [id])
  tipo             TipoPago    @default(gasto)
  /// Familia que recibe la devolución (solo cuando tipo = devolucion).
  familiaId        String?     @map("familia_id")
  familia          Familia?    @relation(fields: [familiaId], references: [id], onDelete: NoAction)

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  aprobaciones Aprobacion[]

  @@map("pagos")
}

model Aprobacion {
  id                String             @id @default(cuid())
  bolsaId           String?            @map("bolsa_id")
  pagoId            String             @map("pago_id")
  pago              Pago               @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  responsableId     String             @map("responsable_id")
  responsable       Responsable        @relation(fields: [responsableId], references: [id])
  responsableNombre String?            @map("responsable_nombre")
  decision          DecisionAprobacion
  fecha             DateTime           @default(now())

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  @@unique([pagoId, responsableId])
  @@map("aprobaciones")
}

model Registro {
  id                String         @id @default(cuid())
  bolsaId           String         @map("bolsa_id")
  bolsa             Bolsa          @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  tipo              TipoMovimiento
  detalle           String
  secuencia         Int
  codigo            String         @unique
  anterior          String?
  enlaceVerificable String?        @map("enlace_verificable")
  fuente            FuenteRegistro @default(demostracion)

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  aporte Aporte?
  pago   Pago?

  @@unique([bolsaId, secuencia])
  @@map("registros")
}

/// Historial de recordatorios de pago enviados desde el CRM.
model Recordatorio {
  id             String            @id @default(cuid())
  bolsaId        String            @map("bolsa_id")
  bolsa          Bolsa             @relation(fields: [bolsaId], references: [id], onDelete: Cascade)
  familiaId      String            @map("familia_id")
  familia        Familia           @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  enviadoPorId   String            @map("enviado_por_id")
  enviadoPor     Responsable       @relation(fields: [enviadoPorId], references: [id], onDelete: NoAction)
  canal          CanalRecordatorio @default(whatsapp)
  saldoPendiente Decimal           @map("saldo_pendiente") @db.Decimal(10, 2)
  fecha          DateTime          @default(now())

  createdById String?  @map("created_by_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")

  @@index([bolsaId, familiaId])
  @@map("recordatorios")
}
